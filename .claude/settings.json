{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(xcodebuild test *)",
      "Bash(swiftlint --quiet *)",
      "Bash(xcrun xccov *)",
      "Bash(xcrun simctl list *)"
    ],
    "deny": [
      "Bash(gws*)",
      "Bash(mail*)",
      "Bash(sendmail*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)"
    ],
    "ask": [
      "Bash(curl* -X DELETE*)",
      "Bash(gcloud* delete*)",
      "Bash(gcloud* destroy*)",
      "Bash(aws* delete*)",
      "Bash(aws* terminate*)",
      "Bash(az* delete*)",
      "Bash(terraform* destroy*)",
      "Bash(npm publish*)",
      "Bash(pnpm add *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(brew install *)",
      "Bash(npm install -g *)",
      "Bash(npm install --global *)",
      "Bash(winget install *)",
      "Bash(dotnet tool install *)",
      "Bash(cargo install *)"
    ]
  },
  "hooks": {},
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "remotion@remotion": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "remotion": {
      "source": {
        "source": "github",
        "repo": "remotion-dev/claude-code-plugin"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "theme": "light",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
