{
  "plugins": {
    "swarm": {
      "enabled": true
    }
  },
  "userSettings": {
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_AUTO",
    "enableTerminalSandbox": true,
    "globalPermissionGrants": {
      "allow": [
        "command(regex:git (commit|push)(\\s.*)?)",
        "command(regex:gh pr (create|edit|view|list|checks|diff)(\\s.*)?)",
        "command(regex:gh issue (create|edit|view|list)(\\s.*)?)",
        "command(regex:xcodebuild test(\\s.*)?)",
        "command(regex:swiftlint --quiet(\\s.*)?)",
        "command(regex:xcrun xccov(\\s.*)?)",
        "command(regex:xcrun simctl list(\\s.*)?)"
      ],
      "ask": [
        "command(regex:.*curl.*-X\\s?DELETE.*)",
        "unsandboxed(regex:.*curl.*-X\\s?DELETE.*)",
        "command(regex:.*gcloud.*(delete|destroy).*)",
        "unsandboxed(regex:.*gcloud.*(delete|destroy).*)",
        "command(regex:.*aws.*(delete|terminate).*)",
        "unsandboxed(regex:.*aws.*(delete|terminate).*)",
        "command(regex:.*az.*delete.*)",
        "unsandboxed(regex:.*az.*delete.*)",
        "command(regex:.*terraform.*destroy.*)",
        "unsandboxed(regex:.*terraform.*destroy.*)",
        "command(regex:(^|.*[;&|]\\s*)npm publish(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)npm publish(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)pnpm add(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)pnpm add(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)uv add(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)uv add(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)uv pip install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)uv pip install(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)pip3? install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)pip3? install(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)brew install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)brew install(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)npm install (-g|--global)(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)npm install (-g|--global)(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)winget install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)winget install(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)dotnet tool install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)dotnet tool install(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)cargo install(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)cargo install(\\s.*)?)"
      ],
      "deny": [
        "command(regex:(^|.*[;&|]\\s*)gws(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)gws(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)(mail|sendmail)(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)(mail|sendmail)(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)git (reset|rebase)(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)git (reset|rebase)(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)gh (auth|secret)(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)gh (auth|secret)(\\s.*)?)",
        "command(regex:(^|.*[;&|]\\s*)gh repo delete(\\s.*)?)",
        "unsandboxed(regex:(^|.*[;&|]\\s*)gh repo delete(\\s.*)?)",
        "command(regex:.*gh\\s+api\\s+.*(-X\\s?DELETE|--method[=\\s]DELETE).*)",
        "unsandboxed(regex:.*gh\\s+api\\s+.*(-X\\s?DELETE|--method[=\\s]DELETE).*)",
        "command(regex:.*gh\\s+api\\s+graphql.*delete.*)",
        "unsandboxed(regex:.*gh\\s+api\\s+graphql.*delete.*)"
      ]
    },
    "themeMode": "THEME_MODE_INHERIT"
  }
}
