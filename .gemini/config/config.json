{
  "plugins": {
    "swarm": {
      "enabled": true
    }
  },
  "userSettings": {
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_AUTO",
    "enableTerminalSandbox": true,
    "globalPermissionGrants": {
      "allow": [
        "command(git commit)",
        "command(git push)",
        "command(gh pr create)",
        "command(gh pr edit)",
        "command(gh pr view)",
        "command(gh pr list)",
        "command(gh pr checks)",
        "command(gh pr diff)",
        "command(gh issue create)",
        "command(gh issue edit)",
        "command(gh issue view)",
        "command(gh issue list)",
        "command(xcodebuild test)",
        "command(swiftlint --quiet)",
        "command(xcrun xccov)",
        "command(xcrun simctl list)"
      ],
      "ask": [
        "command(regex:curl.*-X ?DELETE)",
        "command(regex:gcloud.*(delete|destroy))",
        "command(regex:aws.*(delete|terminate))",
        "command(regex:az.*delete)",
        "command(regex:terraform.*destroy)",
        "command(npm publish)",
        "command(pnpm add)",
        "command(uv add)",
        "command(uv pip install)",
        "command(pip install)",
        "command(pip3 install)",
        "command(brew install)",
        "command(npm install -g)",
        "command(npm install --global)",
        "command(winget install)",
        "command(dotnet tool install)",
        "command(cargo install)"
      ],
      "deny": [
        "command(gws)",
        "command(mail)",
        "command(sendmail)",
        "command(git reset)",
        "command(git rebase)",
        "command(gh auth)",
        "command(gh secret)",
        "command(gh repo delete)",
        "command(regex:gh api .*(-X ?DELETE|--method[= ]DELETE))",
        "command(regex:gh api graphql.*delete)",
        "read_file(.env)",
        "read_file(.env.local)",
        "read_file(secrets/)",
        "read_file(credentials.json)"
      ]
    },
    "themeMode": "THEME_MODE_INHERIT"
  }
}
